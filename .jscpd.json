{
  "pattern": "{backend,frontend}/**/*.{py,ts,tsx}",
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/dist/**",
    "**/coverage/**",
    "**/migrations/**",
    "**/*.test.*",
    "**/*_test.py",
    "**/tests/**"
  ],
  "minTokens": 50,
  "minLines": 5,
  "threshold": 1,
  "reporters": ["consoleFull"],
  "gitignore": true
}
